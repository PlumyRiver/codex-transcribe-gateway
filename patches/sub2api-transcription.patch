diff --git a/backend/internal/service/openai_transcribe.go b/backend/internal/service/openai_transcribe.go
new file mode 100644
index 0000000..ee118a7
--- /dev/null
+++ b/backend/internal/service/openai_transcribe.go
@@ -0,0 +1,261 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/logger"
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	"go.uber.org/zap"
+)
+
+const chatGPTTranscribeURL = "https://chatgpt.com/backend-api/transcribe"
+const openAIAudioTranscriptionsURL = "https://api.openai.com/v1/audio/transcriptions"
+const codexAudioMaxBytes = 25 * 1024 * 1024
+
+// Codex's dictation endpoint chooses its model server-side unless it explicitly
+// reports otherwise. A requested model name is not proof of model identity.
+type CodexTranscribeRequest struct {
+	Body           []byte
+	ContentType    string
+	RequestedModel string
+}
+
+// Explicit transcription models use the public audio endpoint with the same
+// Codex OAuth bearer. The legacy server-selected dictation alias retains its
+// original endpoint; there is no retry or automatic endpoint fallback.
+func (r *CodexTranscribeRequest) UpstreamURL() string {
+	if r.RequestedModel == "codex-transcribe" {
+		return chatGPTTranscribeURL
+	}
+	return openAIAudioTranscriptionsURL
+}
+
+func (r *CodexTranscribeRequest) UpstreamPath() string {
+	if r.RequestedModel == "codex-transcribe" {
+		return "/backend-api/transcribe"
+	}
+	return "/v1/audio/transcriptions"
+}
+
+func ParseCodexTranscribeRequest(body []byte, contentType string) (*CodexTranscribeRequest, error) {
+	mediaType, params, err := mime.ParseMediaType(contentType)
+	if err != nil || mediaType != "multipart/form-data" || params["boundary"] == "" {
+		return nil, errors.New("multipart/form-data with a boundary is required")
+	}
+	if len(body) > codexAudioMaxBytes+1024*1024 {
+		return nil, errors.New("audio upload exceeds 25 MiB")
+	}
+	reader := multipart.NewReader(bytes.NewReader(body), params["boundary"])
+	seen := make(map[string]bool)
+	arrayCounts := make(map[string]int)
+	model := "codex-transcribe"
+	for {
+		part, err := reader.NextPart()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			return nil, errors.New("invalid multipart body")
+		}
+		name := part.FormName()
+		arrayField := name == "languages[]" || name == "keywords[]"
+		if seen[name] && !arrayField {
+			return nil, errors.New("duplicate multipart field")
+		}
+		seen[name] = true
+		switch name {
+		case "file":
+			if part.FileName() == "" {
+				return nil, errors.New("file must have a filename")
+			}
+			size, readErr := io.Copy(io.Discard, io.LimitReader(part, codexAudioMaxBytes+1))
+			if readErr != nil || size == 0 || size > codexAudioMaxBytes {
+				return nil, errors.New("invalid audio file size")
+			}
+		case "model", "language", "prompt", "response_format", "languages[]", "keywords[]":
+			limit := int64(4096)
+			if name == "prompt" {
+				limit = 4 * 65536
+			}
+			value, readErr := io.ReadAll(io.LimitReader(part, limit+1))
+			if readErr != nil || int64(len(value)) > limit || !utf8.Valid(value) {
+				return nil, errors.New("multipart field too large")
+			}
+			text := strings.TrimSpace(string(value))
+			if name == "prompt" && utf8.RuneCountInString(text) > 65536 {
+				return nil, errors.New("transcription prompt too large")
+			}
+			if arrayField {
+				arrayCounts[name]++
+				if name == "languages[]" && (arrayCounts[name] > 4 || len(text) == 0 || len(text) > 20) {
+					return nil, errors.New("invalid transcription language hints")
+				}
+				if name == "keywords[]" && (arrayCounts[name] > 992 || len(text) == 0 || utf8.RuneCountInString(text) > 80) {
+					return nil, errors.New("invalid transcription keywords")
+				}
+			}
+			if name == "response_format" && text != "json" {
+				return nil, errors.New("Codex dictation only exposes JSON transcripts")
+			}
+			if name == "model" {
+				switch text {
+				case "gpt-transcribe", "gpt-4o-transcribe", "gpt-4o-mini-transcribe", "codex-transcribe":
+					model = text
+				default:
+					return nil, errors.New("unsupported requested transcription model")
+				}
+			}
+		default:
+			return nil, errors.New("unsupported multipart field")
+		}
+		_ = part.Close()
+	}
+	if !seen["file"] {
+		return nil, errors.New("audio file is required")
+	}
+	if model == "codex-transcribe" && len(arrayCounts) > 0 {
+		return nil, errors.New("structured hints require an explicit public transcription model")
+	}
+	if model == "codex-transcribe" && seen["model"] {
+		// This local selector means the server-selected Codex dictation model;
+		// it is not an upstream OpenAI model ID.
+		var normalized bytes.Buffer
+		writer := multipart.NewWriter(&normalized)
+		if err := writer.SetBoundary(params["boundary"]); err != nil {
+			return nil, err
+		}
+		reader := multipart.NewReader(bytes.NewReader(body), params["boundary"])
+		for {
+			part, err := reader.NextPart()
+			if errors.Is(err, io.EOF) {
+				break
+			}
+			if err != nil {
+				return nil, err
+			}
+			if part.FormName() == "model" {
+				_ = part.Close()
+				continue
+			}
+			out, err := writer.CreatePart(part.Header)
+			if err != nil {
+				return nil, err
+			}
+			if _, err := io.Copy(out, part); err != nil {
+				return nil, err
+			}
+		}
+		if err := writer.Close(); err != nil {
+			return nil, err
+		}
+		body = normalized.Bytes()
+	}
+	return &CodexTranscribeRequest{Body: body, ContentType: contentType, RequestedModel: model}, nil
+}
+
+func (s *OpenAIGatewayService) ForwardCodexTranscribe(ctx context.Context, c *gin.Context, account *Account, input *CodexTranscribeRequest) (*OpenAIForwardResult, error) {
+	if s == nil || c == nil || input == nil || account == nil || !account.SupportsOpenAIEndpointCapability(OpenAIEndpointCapabilityTranscription) {
+		return nil, errors.New("Codex transcription requires an OpenAI OAuth account")
+	}
+	token, _, err := s.GetAccessToken(ctx, account)
+	if err != nil {
+		return nil, err
+	}
+	// Do not detach from the caller or retry audio after a failed dispatch.
+	ctx = WithHTTPUpstreamRedirectsDisabled(WithHTTPUpstreamProfile(ctx, HTTPUpstreamProfileOpenAI))
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, input.UpstreamURL(), bytes.NewReader(input.Body))
+	if err != nil {
+		return nil, err
+	}
+	if input.RequestedModel == "codex-transcribe" {
+		headers, err := s.buildOpenAIAuthenticationHeaders(ctx, account, token)
+		if err != nil {
+			return nil, err
+		}
+		req.Header = headers
+		if err := resolveAndSetOpenAIChatGPTAccountHeaders(ctx, s.accountRepo, req.Header, account); err != nil {
+			return nil, err
+		}
+	} else {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	req.Header.Set("Content-Type", input.ContentType)
+	req.Header.Set("Accept", "application/json")
+	started := time.Now()
+	response, err := s.doOpenAIUpstream(req, resolveAccountProxyURL(account), account)
+	if err != nil {
+		return nil, err
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, 2*1024*1024+1))
+	if err != nil || len(body) > 2*1024*1024 {
+		return nil, errors.New("invalid transcription response size")
+	}
+	if response.StatusCode >= 300 || response.StatusCode < 200 {
+		if retry := response.Header.Get("Retry-After"); retry != "" {
+			c.Header("Retry-After", retry)
+		}
+		status := response.StatusCode
+		if status < 400 {
+			status = http.StatusBadGateway
+		}
+		code := "upstream_rejected"
+		switch {
+		case strings.EqualFold(response.Header.Get("Cf-Mitigated"), "challenge"):
+			code = "upstream_challenge_required"
+		case response.StatusCode == http.StatusUnauthorized:
+			code = "upstream_authentication_failed"
+		case response.StatusCode == http.StatusForbidden:
+			code = "upstream_access_denied"
+		case response.StatusCode == http.StatusTooManyRequests:
+			code = "upstream_rate_limited"
+		}
+		logger.FromContext(ctx).Warn("codex_transcribe.upstream_rejected",
+			zap.Int("upstream_status", response.StatusCode), zap.String("error_code", code),
+			zap.String("content_type", truncateOpenAIWSLogValue(response.Header.Get("Content-Type"), 120)),
+			zap.String("request_id", truncateOpenAIWSLogValue(response.Header.Get("X-Request-Id"), 120)))
+		c.JSON(status, gin.H{"error": gin.H{"type": "upstream_error", "code": code,
+			"upstream_status": response.StatusCode, "message": "Codex transcription upstream rejected the request"}})
+		return nil, nil
+	}
+	var transcript struct {
+		Text  *string `json:"text"`
+		Model string  `json:"model"`
+	}
+	if err := json.Unmarshal(body, &transcript); err != nil || transcript.Text == nil {
+		return nil, errors.New("upstream did not return a transcript")
+	}
+	upstreamModel := strings.TrimSpace(transcript.Model)
+	if input.RequestedModel != "codex-transcribe" && upstreamModel != "" && upstreamModel != input.RequestedModel {
+		return nil, errors.New("transcription model mismatch")
+	}
+	if upstreamModel == "" {
+		c.Header("X-Sub2api-Transcription-Model", "upstream-selected")
+		c.Header("X-Sub2api-Model-Verification", "unreported")
+	} else {
+		c.Header("X-Sub2api-Transcription-Model", upstreamModel)
+		c.Header("X-Sub2api-Model-Verification", "upstream-reported")
+	}
+	if requestID := response.Header.Get("x-request-id"); requestID != "" {
+		c.Header("X-Request-Id", requestID)
+	}
+	c.Data(response.StatusCode, "application/json", body)
+	return &OpenAIForwardResult{
+		RequestID: "codex-transcribe-" + uuid.NewString(), Model: input.RequestedModel,
+		UpstreamModel: upstreamModel, Duration: time.Since(started), UpstreamHeaders: response.Header,
+		// The private endpoint supplies no reliable usage. The handler requires
+		// an explicitly zero-priced group; never invent token/duration charges.
+		AudioUsage: &AudioUsage{Mode: "stt", DurationOrUnits: 0},
+	}, nil
+}
diff --git a/backend/internal/service/openai_transcribe_test.go b/backend/internal/service/openai_transcribe_test.go
new file mode 100644
index 0000000..3fa4bcf
--- /dev/null
+++ b/backend/internal/service/openai_transcribe_test.go
@@ -0,0 +1,206 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/tlsfingerprint"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func transcriptionFixture(t *testing.T, fields ...string) ([]byte, string) {
+	t.Helper()
+	var body bytes.Buffer
+	w := multipart.NewWriter(&body)
+	part, err := w.CreateFormFile("file", "voice.wav")
+	require.NoError(t, err)
+	_, err = part.Write([]byte("RIFF-test-audio"))
+	require.NoError(t, err)
+	for i := 0; i < len(fields); i += 2 {
+		require.NoError(t, w.WriteField(fields[i], fields[i+1]))
+	}
+	require.NoError(t, w.Close())
+	return body.Bytes(), w.FormDataContentType()
+}
+
+func TestParseCodexTranscribePreservesAudioAndRequestedModel(t *testing.T) {
+	body, contentType := transcriptionFixture(t, "language", "zh", "model", "gpt-transcribe")
+	input, err := ParseCodexTranscribeRequest(body, contentType)
+	require.NoError(t, err)
+	require.Equal(t, "gpt-transcribe", input.RequestedModel)
+	require.Equal(t, body, input.Body)
+	plain, plainType := transcriptionFixture(t)
+	input, err = ParseCodexTranscribeRequest(plain, plainType)
+	require.NoError(t, err)
+	require.Equal(t, "codex-transcribe", input.RequestedModel)
+	alias, aliasType := transcriptionFixture(t, "model", "codex-transcribe")
+	input, err = ParseCodexTranscribeRequest(alias, aliasType)
+	require.NoError(t, err)
+	require.NotContains(t, string(input.Body), "codex-transcribe")
+	require.Contains(t, string(input.Body), "RIFF-test-audio")
+}
+
+func TestParseCodexTranscribeRejectsAmbiguousOrUnsupportedInput(t *testing.T) {
+	for _, fields := range [][]string{
+		{"model", "gpt-transcribe", "model", "gpt-4o-mini-transcribe"},
+		{"model", "invented-model"}, {"stream", "true"}, {"response_format", "text"},
+	} {
+		body, contentType := transcriptionFixture(t, fields...)
+		_, err := ParseCodexTranscribeRequest(body, contentType)
+		require.Error(t, err)
+	}
+	_, err := ParseCodexTranscribeRequest([]byte(`{}`), "application/json")
+	require.Error(t, err)
+	_, err = ParseCodexTranscribeRequest([]byte("bad"), "multipart/form-data; boundary=x")
+	require.Error(t, err)
+}
+
+type transcriptionHTTPStub struct {
+	liveHTTPUpstreamStub
+	status   int
+	response string
+	headers  http.Header
+	calls    int
+}
+
+func (s *transcriptionHTTPStub) Do(req *http.Request, _ string, _ int64, _ int) (*http.Response, error) {
+	s.calls++
+	s.request = req
+	s.body, _ = io.ReadAll(req.Body)
+	headers := s.headers
+	if headers == nil {
+		headers = http.Header{"Content-Type": {"application/json"}}
+	}
+	return &http.Response{StatusCode: s.status, Header: headers, Body: io.NopCloser(strings.NewReader(s.response))}, nil
+}
