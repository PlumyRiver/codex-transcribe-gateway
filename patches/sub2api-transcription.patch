@@ -0,0 +1,105 @@
+package handler
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+
+	pkghttputil "github.com/Wei-Shaw/sub2api/internal/pkg/httputil"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/ip"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/logger"
+	middleware2 "github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"go.uber.org/zap"
+)
+
+// CodexTranscribe is an opt-in private dictation relay. It must not silently
+// charge guessed audio seconds or treat a requested model as a verified one.
+func (h *OpenAIGatewayHandler) CodexTranscribe(c *gin.Context) {
+	apiKey, ok := middleware2.GetAPIKeyFromContext(c)
+	if !ok || apiKey.Group == nil || apiKey.Group.Platform != service.PlatformOpenAI {
+		h.errorResponse(c, 403, "permission_error", "Codex transcription requires an OpenAI group")
+		return
+	}
+	if !apiKey.Group.AllowLive || apiKey.Group.AudioSTTPricePerHour == nil || *apiKey.Group.AudioSTTPricePerHour != 0 {
+		h.errorResponse(c, 403, "permission_error", "Enable Live and explicitly set STT price to zero for private Codex dictation; upstream usage is unreported")
+		return
+	}
+	subject, ok := middleware2.GetAuthSubjectFromContext(c)
+	if !ok {
+		h.errorResponse(c, 401, "authentication_error", "User context is required")
+		return
+	}
+	if !h.ensureResponsesDependencies(c, nil) {
+		return
+	}
+	body, err := pkghttputil.ReadRequestBodyWithPrealloc(c.Request)
+	if err != nil {
+		h.errorResponse(c, 413, "invalid_request_error", "Cannot read audio upload")
+		return
+	}
+	input, err := service.ParseCodexTranscribeRequest(body, c.GetHeader("Content-Type"))
+	if err != nil {
+		h.errorResponse(c, 400, "invalid_request_error", err.Error())
+		return
+	}
+	if !apiKey.Group.ModelAllowlist.Allows(input.RequestedModel) {
+		h.errorResponse(c, 404, "not_found_error", "Requested model is not allowed in this group")
+		return
+	}
+	subscription, _ := middleware2.GetSubscriptionFromContext(c)
+	if err := h.billingCacheService.CheckBillingEligibility(c.Request.Context(), apiKey.User, apiKey, apiKey.Group, subscription, service.QuotaPlatform(c.Request.Context(), apiKey)); err != nil {
+		status, code, message, retry := billingErrorDetails(err)
+		if retry > 0 {
+			c.Header("Retry-After", strconv.Itoa(retry))
+		}
+		h.errorResponse(c, status, code, message)
+		return
+	}
+	userRelease, acquired, err := h.concurrencyHelper.TryAcquireUserSlot(c.Request.Context(), subject.UserID, subject.Concurrency)
+	if err != nil || !acquired {
+		h.errorResponse(c, 429, "rate_limit_error", "Transcription concurrency unavailable")
+		return
+	}
+	defer userRelease()
+	// No account rotation/retry after forwarding audio; a failed request must
+	// not quietly become a second subscription charge on another account.
+	selection, _, err := h.gatewayService.SelectAccountWithSchedulerForCapability(
+		service.WithOpenAIProfitControlSuppressed(c.Request.Context()), apiKey.GroupID,
+		"", "", "", nil, service.OpenAIUpstreamTransportHTTPSSE,
+		service.OpenAIEndpointCapabilityTranscription, false, false, false, service.PlatformOpenAI)
+	if err != nil || selection == nil || selection.Account == nil || !selection.Acquired {
+		if selection != nil && selection.ReleaseFunc != nil {
+			selection.ReleaseFunc()
+		}
+		h.errorResponse(c, 503, "api_error", "No eligible Codex OAuth transcription account")
+		return
+	}
+	if selection.ReleaseFunc != nil {
+		defer selection.ReleaseFunc()
+	}
+	result, err := h.gatewayService.ForwardCodexTranscribe(c.Request.Context(), c, selection.Account, input)
+	if err != nil {
+		if !c.Writer.Written() {
+			h.errorResponse(c, http.StatusBadGateway, "upstream_error", "Codex transcription request failed")
+		}
+		return
+	}
+	if result == nil {
+		return
+	}
+	usage := &service.OpenAIRecordUsageInput{
+		Result: result, APIKey: apiKey, User: apiKey.User, Account: selection.Account,
+		Subscription: subscription, InboundEndpoint: GetInboundEndpoint(c), UpstreamEndpoint: input.UpstreamPath(),
+		UserAgent: c.GetHeader("User-Agent"), IPAddress: ip.GetClientIP(c),
+		RequestPayloadHash: service.HashUsageRequestPayload(body), APIKeyService: h.apiKeyService,
+		QuotaPlatform: service.QuotaPlatform(c.Request.Context(), apiKey),
+	}
+	h.submitMandatoryUsageRecordTask(c.Request.Context(), func(ctx context.Context) {
+		// submitMandatoryUsageRecordTask supplies the existing durable recorder.
+		if err := h.gatewayService.RecordUsage(ctx, usage); err != nil {
+			logger.L().Error("codex_transcribe.record_usage_failed", zap.Error(err), zap.Int64("api_key_id", apiKey.ID))
+		}
+	})
+}
