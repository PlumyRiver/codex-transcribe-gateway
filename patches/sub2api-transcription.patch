+package handler
+
+import (
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestCodexTranscribeRejectsGroupsWithoutExplicitPrivateVoiceConfiguration(t *testing.T) {
+	zero, nonzero := 0.0, 1.0
+	for _, group := range []*service.Group{
+		nil,
+		{Platform: service.PlatformGrok, AllowLive: true, AudioSTTPricePerHour: &zero},
+		{Platform: service.PlatformOpenAI, AudioSTTPricePerHour: &zero},
+		{Platform: service.PlatformOpenAI, AllowLive: true},
+		{Platform: service.PlatformOpenAI, AllowLive: true, AudioSTTPricePerHour: &nonzero},
+	} {
+		writer := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(writer)
+		c.Request = httptest.NewRequest("POST", "/v1/audio/transcriptions", nil)
+		c.Set(string(middleware.ContextKeyAPIKey), &service.APIKey{Group: group})
+		(&OpenAIGatewayHandler{}).CodexTranscribe(c)
+		require.Equal(t, 403, writer.Code)
+	}
+}
